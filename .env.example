# Telegram Bot Configuration
# Copy this file to .env and fill in your values
# OR set these as environment variables directly (e.g. on Railway)

# ── Required ──
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_ENDPOINT_ID=your_main_runpod_endpoint_id
DATABASE_URL=postgresql://user:pass@host:5432/dbname
ADMIN_TELEGRAM_ID=your_telegram_user_id

# ── RunPod Endpoints ──
RUNPOD_KENPECHI_ENDPOINT_ID=your_kenpechi_endpoint_id
RUNPOD_V9_ENDPOINT_ID=your_v9_endpoint_id

# ── WebApp ──
# Set to your public URL (Railway auto-sets, or use ngrok for local dev)
# WEBAPP_URL=https://your-app.up.railway.app

# ── Auto-Prompt (SiliconFlow) ──
SILICONFLOW_API_KEY=your_siliconflow_api_key
# AUTOPROMPT_ENABLED=true

# ── Server ──
# PORT=8080
